{
  "name": "math-learning-cloud-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare remote MCP and learning-state API for the YBT math learning system",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && node --test tests/*.test.mjs",
    "import:dry": "node scripts/import_content.mjs --dry-run",
    "import:remote": "node scripts/import_content.mjs --remote",
    "handouts:dry": "node scripts/import_handouts.mjs --index ../../tmp/handout-index/index.json",
    "handouts:remote": "node scripts/import_handouts.mjs --index ../../tmp/handout-index/index.json --remote",
    "practice:dry": "node scripts/import_practice_book.mjs --index ../../tmp/practice-book-index/index.json",
    "practice:remote": "node scripts/import_practice_book.mjs --index ../../tmp/practice-book-index/index.json --remote",
    "exams:dry": "node scripts/import_exam_papers.mjs",
    "exams:remote": "node scripts/import_exam_papers.mjs --remote",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:dry": "wrangler deploy --dry-run"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "agents": "^0.20.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260818.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.124.0"
  }
}
